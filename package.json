{
  "name": "ashenfall",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Servidor autoritativo y cliente de ASHENFALL, duelo 1v1 por turnos de proyectiles.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b apps/server apps/bot && npm run build -w @ashenfall/client",
    "typecheck": "tsc -b apps/server apps/bot --pretty && tsc -p tsconfig.tests.json --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.12.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
