# Valores para desarrollo local con docker compose. En Azure llegan por Key Vault e identidad administrada.
DATABASE_URL=postgres://ashenfall@127.0.0.1:5432/ashenfall
REDIS_URL=redis://127.0.0.1:6379
# Opcionales (valores por defecto): espera máxima en la cola rápida y periodo de gracia para reconectar, en ms.
# MATCHMAKING_MAX_WAIT_MS=60000
# RECONNECT_GRACE_MS=60000
